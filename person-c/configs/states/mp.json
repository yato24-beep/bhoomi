  "fields": {
    "khasra_number": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:खसरा\\s*(?:क्रमांक|नं|नंबर)?|भूखण्ड\\s*क्रमांक)[\\s:.-]*([०-९0-9]+(?:[\\/\\-][०-९0-9]+)*)"
      ]
    },
    "khatauni_number": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:खाता\\s*(?:क्रमांक|नं|संख्या)?)[\\s:.-]*([०-९0-9]+)"
      ]
    },
    "owner_name": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:भूमिस्वामी(?:\\s*का\\s*नाम)?|खातेदार(?:\\s*का\\s*नाम)?)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:पिता|पति|आत्मज|s\\/o|w\\/o|निवासी|\\n|$))"
      ]
    },
    "father_or_husband_name": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:पिता|पति|आत्मज|संरक्षक)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:निवासी|जाति|रकबा|\\n|$))"
      ]
    },
    "land_area": {
      "type": "float",
      "required": true,
      "patterns": [
        "(?:रकबा|क्षेत्रफल)[\\s:.-]*([०-९0-9]+(?:\\.[०-९0-9]+)?)\\s*(हेक्टेयर|हे|बीघा|एकड़)?",
        "([०-९0-9]+\\.[०-९0-9]+)\\s*(?:हेक्टेयर|हे)"
      ]
    },
    "village": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:ग्राम|गांव)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:पटवारी\\s*हल्का|तहसील|थाना|जिला|\\n|$))"
      ]
    },
    "tehsil": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:तहसील)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:जिला|\\n|$))"
      ]
    },
    "district": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:जिला)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:मध्य\\s*प्रदेश|तहसील|प्रदेश|\\n|$))"
      ]
    }
  },
  "validation_rules": {
    "land_area": {
      "min": 0.0001,
      "max": 1000.0,
      "message": "MP Land area must be positive and reasonable"
    },
    "khasra_number": {
      "pattern": "^[0-9]+(/[0-9]+)*$",
      "message": "MP Khasra must be standard number or slash sub-khasra"
    }
  }
}