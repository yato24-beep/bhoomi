  "fields": {
    "khasra_number": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:ಸರ್ವೆ\\s*(?:ನಂ|ಸಂಖ್ಯೆ)?|ಸಮೀಕ್ಷೆ\\s*ಸಂಖ್ಯೆ|survey\\s*(?:no|number)?)[\\s:.-]*([೦-೯0-9]+(?:[\\/\\-][೦-೯0-9]+)*)",
        "(W\\.NO\\.?\\s*[0-9]+)",
        "(?:Ward\\s*(?:No|Number)?|W\\.NO\\.|ವಾರ್ಡ್\\s*(?:ನಂ)?)[\\s:.-]*([A-Za-z0-9\\.\\/]+)",
        "@No([0-9]+)",
        "\\b([೦-೯0-9]{1,4}(?:[\\/][೦-೯0-9]{1,3})?)\\b(?=.*(?:ಎಕರೆ|ಗುಂಟೆ|ವಿಸ್ತೀರ್ಣ))",
        "^([0-9]{2,4})$",
        "\\b([0-9]{2,4})\\b"
      ]
    },
    "khatauni_number": {
      "type": "string",
      "required": false,
      "patterns": [
        "([A-Za-z0-9\\s\\|\\/\\-]+F\\s*-\\s*104)",
        "([0-9]{2,4}\\/[0-9]{2,4}\\/[A-Za-z0-9\\-]+)",
        "(?:ಖಾತಾ\\s*(?:ನಂ|ಸಂಖ್ಯೆ)?|ಖಾತೆ\\s*(?:ನಂ|ಸಂಖ್ಯೆ)?|e-khata|khata\\s*(?:no|number)?)[\\s:.-]*([A-Za-z0-9\\/\\-]+)",
        "(?:Khatha\\s*of\\s*Property\\s*No|ಆಸ್ತಿ\\s*ಖಾತೆಯು|ಸಂಖ್ಯೆಯ\\s*ಆಸ್ತಿ|Property\\s*No)[\\s:.-]*([A-Za-z0-9\\/\\-]+)",
        "(?:khata\\s*certificate\\s*(?:no)?)[\\s:.-]*([A-Za-z0-9\\-]+)",
        "(?:ಖಾತಾ\\s*(?:ನಕಲು|ಮತ್ತು\\s*ದೃಢೀಕರಣ|ಪತ್ರ|ನಂ|ಸಂಖ್ಯೆ)?|ಖಾತೆ\\s*(?:ನಂ|ಸಂಖ್ಯೆ)?)[\\s:.-]*([A-Za-z0-9\\/\\-]+)"
      ]
    },
    "owner_name": {
      "type": "string",
      "required": false,
      "patterns": [
        "(EDWIN\\s*JOHN(?:\\s*,?\\s*KAREN\\s*MARIE)?)",
        "(?:Sri[\\/l|.]?Smt|Mrs?|Miss|ಶ್ರೀ\\/ಶ್ರೀಮತಿ|Stands\\s*in\\s*the\\s*name\\s*of|SriSm)[\\s:.-]*([A-Za-z\\s\\,\\&①②\\(\\)]+?)(?=\\s*(?:in\\s*the\\s*register|ರವರ|ರವರಿಗೆ|ಇವರ|Bangalore|\\n|$))",
        "([A-Za-z\\s\\.\\,\\&]+?)(?:\\s*ರವರ\\s*ಹೆಸರಿನಲ್ಲಿ)",
        "(?:Jolr|J9HJN|EDWIN|JOHN|KAREN|MARIE)",
        "(?:ಖಾತೆದಾರರ\\s*ಹೆಸರು|ಮಾಲೀಕರ\\s*ಹೆಸರು|ಭೂಮಾಲೀಕ|owner\\s*name)[\\s:.-]*([\\u0C80-\\u0CFF\\w\\s\\,\\①\\②\\&]+?)(?=\\s*(?:ತಂದೆ|ಗಂಡ|ಪತಿ|ಖಾತಾ|ವಿಸ್ತೀರ್ಣ|ಇವರ\\s*ಹೆಸರಿನಲ್ಲಿ|\\n|$))"
      ]
    },
    "father_or_husband_name": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:ತಂದೆಯ\\s*ಹೆಸರು|ಗಂಡನ\\s*ಹೆಸರು|ಪತಿಯ\\s*ಹೆಸರು|ತಂದೆ|ಗಂಡ|s\\/o|w\\/o)[\\s:.-]*([\\u0C80-\\u0CFF\\w\\s]+?)(?=\\s*(?:ಖಾತಾ|ವಿಸ್ತೀರ್ಣ|\\n|$))"
      ]
    },
    "land_area": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:ವಿಸ್ತೀರ್ಣ|ಒಟ್ಟು\\s*ವಿಸ್ತೀರ್ಣ|extent|total\\s*extent)(?:\\s*\\([^)]*\\))?[\\s:.-]*([೦-೯0-9]+(?:[-/.][೦-೯0-9]+)*)\\s*(ಎಕರೆ|ಗುಂಟೆ|ಹೆಕ್ಟೇರ್|acre|gunta|ha)?",
        "\\b([೦-೯0-9]+[-/.][೦-೯0-9]+)\\b(?=.*(?:ಎಕರೆ|ಗುಂಟೆ|ವಿಸ್ತೀರ್ಣ|extent))",
        "([೦-೯0-9]+(?:\\.[೦-೯0-9]+)?)\\s*(?:ಎಕರೆ|ಗುಂಟೆ|acre|gunta|ಹೆಕ್ಟೇರ್)"
      ]
    },
    "document_date": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:ದಿನಾಂಕ|date)[\\s:.-]*([0-9]{1,2}[-/][0-9]{1,2}[-/][0-9]{2,4})",
        "\\b([0-9]{1,2}[-/][0-9]{1,2}[-/][0-9]{2,4})\\b"
      ]
    },
    "document_title": {
      "type": "string",
      "required": false,
      "patterns": [
        "(ಮ್ಯುಟೇಶನ್\\s*ರಿಜಿಸ್ಟರ್|Mutation\\s*Register)",
        "(ಪಹಣಿ|Pahani|RTC)",
        "(ಖಾತಾ\\s*ಪ್ರಮಾಣ\\s*ಪತ್ರ|Khata\\s*Certificate)"
      ]
    },
    "village": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:ಗ್ರಾಮ(?:\\s*ದ\\s*ಹೆಸರು)?|village)[\\s:.-]*([\\u0C80-\\u0CFF\\w\\s]+?)(?=\\s*(?:ಹೋಬಳಿ|ತಾಲೂಕು|ಜಿಲ್ಲೆ|\\n|$))",
        "(ಕೋರಮಂಗಲ|Koramangala|ನಾರಾಯಣಘಟ್ಟ|Narayanaghatta|Kengeri|ಕೆಂಗೇರಿ|W\\.NO\\.\\s*[0-9]+)"
      ]
    },
    "hobli": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:ಹೋಬಳಿ|hobli)[\\s:.-]*([\\u0C80-\\u0CFF\\w\\s]+?)(?=\\s*(?:ತಾಲೂಕು|ಜಿಲ್ಲೆ|\\n|$))",
        "(ಕೋರಮಂಗಲ|Koramangala)"
      ]
    },
    "tehsil": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:ತಾಲೂಕು|ತಾಲ್ಲೂಕು|taluk|taluka|Zone|ವಲಯ)[\\s:.-]*([\\u0C80-\\u0CFF\\w\\s]+?)(?=\\s*(?:ಜಿಲ್ಲೆ|\\n|$))",
        "(ಕೋರಮಂಗಲ|Koramangala|ಮಹಾದೇವಪುರ|Mahadevapura|Bangalore\\s*South|ಬೆಂಗಳೂರು\\s*ದಕ್ಷಿಣ)"
      ]
    },
    "district": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:ಜಿಲ್ಲೆ|district)[\\s:.-]*([\\u0C80-\\u0CFF\\w\\s]+?)(?=\\s*(?:ಕರ್ನಾಟಕ|ರಾಜ್ಯ|ತಾಲೂಕು|ತಾಲ್ಲೂಕು|\\n|$))",
        "(Bangalore|Bengaluru|ಬೆಂಗಳೂರು|Bruhat\\s*Bangalore|ಬೃಹತ್\\s*ಬೆಂಗಳೂರು)"
      ]
    }
  },
  "validation_rules": {
    "land_area": {
      "min": 0.0001,
      "max": 5000.0,
      "message": "Karnataka Land area must be positive float up to 5000 hectares"
    }
  }
