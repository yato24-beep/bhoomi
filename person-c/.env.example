# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL / PostGIS / pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=land_records_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# GIS Validation Settings
ENABLE_POSTGIS_LIVE=false
GIS_MISMATCH_TOLERANCE_METERS=50.0

# Duplicate Detection Settings
VECTOR_SIMILARITY_THRESHOLD=0.85

# MLflow Tracking (Person B)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=land-record-ocr-training

# Pipelines and Configs
CONFIG_PATH=configs/
STATE_CONFIG_DIR=configs/states/
DEFAULT_STATE=UP
