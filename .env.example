# ==============================================================================
# Global & Backend Configuration
# ==============================================================================
PROJECT_NAME="Document Processing Platform"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ==============================================================================
# Security & JWT Authentication
# ==============================================================================
# In production, generate a secure random key: `openssl rand -hex 32`
SECRET_KEY="insecure-dev-secret-key-change-this-in-production-1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# ==============================================================================
# PostgreSQL Database
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=doc_platform
# Full connection string for SQLAlchemy
DATABASE_URL=postgresql+psycopg://postgres:postgres_password@localhost:5432/doc_platform

# ==============================================================================
# MinIO Object Storage (S3-Compatible)
# ==============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_BUCKET_NAME=documents
MINIO_SECURE=false

# ==============================================================================
# Redis & Celery Task Queue
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================================================
# Frontend Configuration (Next.js)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
