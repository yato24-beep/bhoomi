  "fields": {
    "khasra_number": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:गाटा\\s*संख्या|खसरा\\s*(?:संख्या|नं|नंबर)?|khasra\\s*no)[\\s:.-]*([०-९0-9]+(?:[\\/\\-][०-९0-9]+)*)",
        "\\b([०-९0-9]{1,4}(?:[\\/][०-९0-9]{1,3})?)\\b(?=.*(?:हेक्टेयर|रकबा|खसरा))"
      ]
    },
    "khatauni_number": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:खाता\\s*(?:संख्या|नं|नंबर)?|khata\\s*no)[\\s:.-]*([०-९0-9]+)",
        "(?:खातौनी\\s*(?:संख्या)?)[\\s:.-]*([०-९0-9]+)"
      ]
    },
    "owner_name": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:खातेदार(?:\\s*का\\s*नाम)?|भूमिधर(?:\\s*का\\s*नाम)?|काश्तकार)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:पिता|पति|सुत|s\\/o|w\\/o|निवासी|निवास|\\n|$))",
        "(?:नाम\\s*खातेदार)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:\\/|पिता|निवासी|$))"
      ]
    },
    "father_or_husband_name": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:पिता|पति|सुत|s\\/o|w\\/o|आत्मज)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:निवासी|निवास|जाति|रकबा|\\n|$))"
      ]
    },
    "land_area": {
      "type": "float",
      "required": true,
      "patterns": [
        "(?:क्षेत्रफल|रकबा)(?:\\s*\\([^)]*\\))?[\\s:.-]*([०-९0-9]+(?:\\.[०-९0-9]+)?)\\s*(हेक्टेयर|हे०|हे|बीघा|बिसवा|एकड़)?",
        "(?:क्षेत्रफल|रकबा)[\\s:.-]*([०-९0-9]+(?:\\.[०-९0-9]+)?)",
        "([०-९0-9]+\\.[०-९0-9]{2,6})\\s*(?:हेक्टेयर|हे०|हे)"
      ]
    },
    "village": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:ग्राम(?:\\s*का\\s*नाम)?|मौजा)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:परगना|तहसील|थाना|पट्टी|जनपद|\\n|$))"
      ]
    },
    "pargana": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:परगना)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:तहसील|जनपद|ज़िला|\\n|$))"
      ]
    },
    "tehsil": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:तहसील)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:जनपद|ज़िला|जिला|\\n|$))"
      ]
    },
    "district": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:जनपद|ज़िला|जिला)[\\s:.-]*([\\u0900-\\u097F\\w\\s]+?)(?=\\s*(?:उत्तर\\s*प्रदेश|तहसील|प्रदेश|\\n|$))"
      ]
    },
    "fasli_year": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:फसली\\s*वर्ष|फसली)[\\s:.-]*([०-९0-9]{4}(?:\\s*[-–]\\s*[०-९0-9]{4})?)"
      ]
    }
  },
  "validation_rules": {
    "land_area": {
      "min": 0.0001,
      "max": 1000.0,
      "message": "UP Land area must be a valid positive float up to 1000 hectares"
    },
    "khasra_number": {
      "pattern": "^[0-9]+(/[0-9]+)*$",
      "message": "Khasra/Gata must be a number or fractional plot (e.g. 142 or 142/1)"
    },
    "khatauni_number": {
      "pattern": "^[0-9]+$",
      "message": "UP Khata number must be numeric"
    }
  }
}