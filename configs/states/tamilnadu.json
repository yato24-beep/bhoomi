  "unit_conversions_to_hectares": {
    "hectare": 1.0,
    "ஹெக்டேர்": 1.0,
    "ஹெக்": 1.0,
    "are": 0.01,
    "ares": 0.01,
    "ஏர்ஸ்": 0.01,
    "ஏர்": 0.01,
    "cent": 0.004047,
    "cents": 0.004047,
    "சென்ட்": 0.004047,
    "ground": 0.022296,
    "கிரவுண்ட்": 0.022296,
    "kuzhi": 0.001349,
    "குழி": 0.001349,
    "acre": 0.404686,
    "ஏக்கர்": 0.404686,
    "sq_meter": 0.0001,
    "சதுர மீட்டர்": 0.0001
  },
  "fields": {
    "khasra_number": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:புல\\s*எண்|சர்வே\\s*(?:எண்|நம்பர்)?|survey\\s*(?:no|number)?)[\\s:.-]*([௦-௯0-9]+(?:[\\/\\-][௦-௯0-9]+)*)",
        "\\b([௦-௯0-9]{1,4}(?:[\\/][௦-௯0-9]{1,3})?)\\b(?=.*(?:ஹெக்டேர்|பரப்பளவு|ஏர்ஸ்|சென்ட்))"
      ]
    },
    "khatauni_number": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:பட்டா\\s*எண்|patta\\s*no)[\\s:.-]*([௦-௯0-9]+)"
      ]
    },
    "owner_name": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:பட்டாதாரர்(?:\\s*பெயர்)?|உரிமையாளர்(?:\\s*பெயர்)?|owner\\s*name)[\\s:.-]*([\\u0B80-\\u0BFF\\w\\s]+?)(?=\\s*(?:தந்தை|கணவர்|பட்டா|பரப்பளவு|\\n|$))",
        "(?:பெயர்)[\\s:.-]*([\\u0B80-\\u0BFF\\w\\s]+?)(?=\\s*(?:தந்தை|கணவர்|\\n|$))"
      ]
    },
    "father_or_husband_name": {
      "type": "string",
      "required": false,
      "patterns": [
        "(?:தந்தை(?:\\s*பெயர்)?|கணவர்(?:\\s*பெயர்)?|தகப்பனார்|s\\/o|w\\/o)[\\s:.-]*([\\u0B80-\\u0BFF\\w\\s]+?)(?=\\s*(?:பட்டா|பரப்பளவு|\\n|$))"
      ]
    },
    "land_area": {
      "type": "float",
      "required": true,
      "patterns": [
        "(?:பரப்பளவு|விஸ்தீரணம்|area|extent)(?:\\s*\\([^)]*\\))?[\\s:.-]*([௦-௯0-9]+(?:\\.[௦-௯0-9]+)?)\\s*(ஹெக்டேர்|ஹெக்|ஏர்ஸ்|சென்ட்|ஏக்கர்|hectare|are|cent)?",
        "([௦-௯0-9]+(?:\\.[௦-௯0-9]+)?)\\s*(?:ஹெக்டேர்|ஹெக்|ஏர்ஸ்|சென்ட்|hectare|acre)"
      ]
    },
    "village": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:கிராமம்(?:\\s*பெயர்)?|village)[\\s:.-]*([\\u0B80-\\u0BFF\\w\\s]+?)(?=\\s*(?:வட்டம்|மாவட்டம்|\\n|$))"
      ]
    },
    "tehsil": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:வட்டம்|தாலுகா|taluk)[\\s:.-]*([\\u0B80-\\u0BFF\\w\\s]+?)(?=\\s*(?:மாவட்டம்|\\n|$))"
      ]
    },
    "district": {
      "type": "string",
      "required": true,
      "patterns": [
        "(?:மாவட்டம்|district)[\\s:.-]*([\\u0B80-\\u0BFF\\w\\s]+?)(?=\\s*(?:தமிழ்நாடு|மாநிலம்|வட்டம்|தாலுகா|\\n|$))"
      ]
    }
  },
  "validation_rules": {
    "land_area": {
      "min": 0.0001,
      "max": 5000.0,
      "message": "Tamil Nadu Land area must be positive float up to 5000 hectares"
    },
    "khasra_number": {
      "pattern": "^[0-9]+(/[0-9]+)*$",
      "message": "Survey/Subdivision number must be numeric format"
    }
  }
}